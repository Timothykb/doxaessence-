{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "doxaessence",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-07",
  "workers_dev": true,
  "routes": [
    { "pattern": "doxaessence.com", "custom_domain": true },
    { "pattern": "www.doxaessence.com", "custom_domain": true }
  ],
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": true },
  "ratelimits": [{ "name": "CHECKOUT_LIMIT", "namespace_id": "2026102901", "simple": { "limit": 20, "period": 60 } }],
  "triggers": { "crons": ["*/5 * * * *"] },
  "build": { "command": "pnpm build" }
}
